generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SUBADMIN
}

model User {
  id String @id @default(cuid())

  phone    String @unique
  password String

  role UserRole

  // Student Only
  academicLevelId String?
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  // Profile
  name        String?
  enrollments ExamEnrollment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model AcademicLevel {
  id String @id @default(cuid())

  name String @unique

  users User[]

  assignments SubjectAssignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id String @id @default(cuid())

  name String

  adminDisplayName String @unique

  isActive Boolean @default(true)

  chapters    Chapter[]
  assignments SubjectAssignment[]

  mcqs  MCQ[]
  exams Exam[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  examSubjects ExamSubject[]
}

model SubjectAssignment {
  id String @id @default(cuid())

  academicLevelId String
  subjectId       String

  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id])
  subject       Subject       @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([academicLevelId, subjectId])
}

model Chapter {
  id String @id @default(cuid())

  name String

  orderNo Int

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  topics Topic[]
  mcqs   MCQ[]
  exams  Exam[]

  isActive Boolean @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  examChapters ExamChapter[]

  @@unique([subjectId, orderNo])
  @@unique([subjectId, name])
  @@index([subjectId])
}

model Topic {
  id      String @id @default(cuid())
  name    String
  orderNo Int

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  isActive Boolean @default(true)

  mcqs MCQ[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, orderNo])
  @@unique([chapterId, name])
}

enum MCQType {
  STANDARD
  MULTI_STATEMENT
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model MCQ {
  id String @id @default(cuid())

  subjectId String
  chapterId String
  topicId   String

  subject Subject @relation(fields: [subjectId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  type MCQType

  scenario Json?

  question Json

  options Json

  correctOptionKey String

  explanation Json?

  references Json?

  optionCount Int

  difficulty DifficultyLevel @default(MEDIUM)

  isPremium Boolean @default(false)
  isActive  Boolean @default(true)

  examMcqs ExamMcq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([difficulty])
  @@index([type])
  @@index([isPremium])
  @@index([isActive])
}

enum ExamType {
  PRACTICE
  LIVE
}

enum EnrollmentType {
  OPEN
  APPROVAL
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Exam {
  id String @id @default(cuid())

  title String

  description String?

  type ExamType

  enrollmentType EnrollmentType @default(OPEN)

  academicLevelId String

  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id])

  orderNo Int?

  durationMinutes Int

  totalMarks Int

  negativeMarks Decimal? @db.Decimal(5, 2)

  startAt DateTime?

  endAt DateTime?

  maxParticipants Int?

  isPublished Boolean @default(false)

  isActive Boolean @default(true)

  subjects ExamSubject[]

  chapters ExamChapter[]

  mcqs ExamMcq[]

  enrollments ExamEnrollment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  chapterId String?
}

model ExamEnrollment {
  id String @id @default(cuid())

  examId    String
  studentId String

  status EnrollmentStatus @default(APPROVED)

  enrolledAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id])

  student User @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model ExamMcq {
  id String @id @default(cuid())

  examId String
  mcqId  String

  orderNo Int?

  mark Decimal @default(1)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  mcq MCQ @relation(fields: [mcqId], references: [id])

  createdAt DateTime @default(now())

  @@unique([examId, mcqId])
  @@index([examId])
  @@index([mcqId])
  @@index([orderNo])
}

model ExamSubject {
  id String @id @default(cuid())

  examId    String
  subjectId String

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
}

model ExamChapter {
  id String @id @default(cuid())

  examId    String
  chapterId String

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([examId, chapterId])
  @@index([examId])
  @@index([chapterId])
}
